PORT=3000

# Database Configuration (Supabase)
DB_HOST=your_supabase_db_host_here
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password_here
DB_NAME=postgres

# Telegram Auth & Roles
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_IDS=123456789,987654321

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# TON Blockchain Payments (Optional/Production)
PLATFORM_WALLET_ADDRESS=your_ton_wallet_address_here
REQUIRE_TX_VERIFICATION=false
REQUIRE_MEMO_VERIFICATION=false
